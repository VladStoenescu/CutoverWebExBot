# Webex Bot Access Token
# Get your bot token from https://developer.webex.com/my-apps
WEBEX_BOT_TOKEN=your_bot_access_token_here

# Port for the webhook server
PORT=3000

# Public URL where your bot is accessible (for webhooks)
# Use ngrok or a similar service for local development
PUBLIC_URL=https://your-public-url.ngrok.io
